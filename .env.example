# ──────────────────────────────────────────────────────────────────────────────
# .env.example – copy to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to "production" before deploying. Controls debug mode.
FLASK_DEBUG=1

# Enable Werkzeug ProxyFix ONLY when running behind a trusted reverse proxy (e.g. nginx, Render, Railway).
TRUST_PROXY=false

# Strong random string – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# ── SMTP (contact form) ───────────────────────────────────────────────────────
# Gmail example. For Gmail, create an App Password (not your login password):
# https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# The Gmail address used to SEND emails (must match MAIL_PASSWORD's app password).
MAIL_USERNAME=your-email@gmail.com

# The Gmail App Password (16-character, no spaces).
MAIL_PASSWORD=your-app-password

# Where contact form emails are DELIVERED. Usually same as MAIL_USERNAME.
MAIL_RECIPIENT=your-email@gmail.com

# ── Rate limiter (optional overrides) ────────────────────────────────────────
# Maximum contact form submissions per IP per window.
# RATE_LIMIT_MAX=5
# Window in seconds (default 600 = 10 minutes).
# RATE_LIMIT_WINDOW=600
